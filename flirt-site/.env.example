# Copy to .env.local for local development, and set the same keys in Vercel
# (Project → Settings → Environment Variables) for production.

# ---------------------------------------------------------------------------
# Booking request form (/book → /api/contact)
# ---------------------------------------------------------------------------
# Without these the form returns a clear "call us instead" message rather than
# silently dropping a booking request. Any SMTP provider works — Google
# Workspace, Zoho, Fastmail, Resend, Postmark.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Where booking requests land. Defaults to the email in src/content/site.json.
CONTACT_TO=
# The From address. Defaults to SMTP_USER. Must be a domain you're allowed to
# send as, or the mail will land in spam.
CONTACT_FROM=

# ---------------------------------------------------------------------------
# Analytics & verification (optional)
# ---------------------------------------------------------------------------
# GA4 measurement ID, e.g. G-XXXXXXXXXX. No script is injected without it.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google Search Console HTML-tag verification token (the content="..." value).
NEXT_PUBLIC_GSC_VERIFICATION=
